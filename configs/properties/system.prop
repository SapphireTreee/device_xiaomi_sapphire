# Brightness Curve
persist.sys.brightness.low.gamma=true

# CNE
persist.vendor.cne.feature=1

# Disable MTE Async for system server
persist.arm64.memtag.system_server=off

# Ftrace
persist.debug.ftrace_events_disable=Yes

# Fingerprint
sys.fp.miui.token=0

# Deep Sleep
pm.sleep_mode=1
vendor.post_boot.parsed=1s

# IMS Debugging
persist.vendor.ims.disableADBLogs=1
persist.vendor.ims.disableDebugLogs=1
persist.vendor.ims.disableIMSLogs=1
persist.vendor.ims.disableQXDMLogs=1

# Fwk-Detect
ro.vendor.qti.va_aosp.support=1

# Hint Manager
debug.hwui.use_hint_manager=true
debug.hwui.target_cpu_time_percent=30

# enable tunnel encoding for amrwb
tunnel.audio.encode=true

# property to latch unsignaled buffer
debug.sf.latch_unsignaled=1

# HWUI
ro.hwui.texture_cache_size=72
ro.hwui.layer_cache_size=48
ro.hwui.r_buffer_cache_size=8
ro.hwui.max_texture_allocation_size=209715200
ro.hwui.path_cache_size=32
ro.hwui.gradient_cache_size=1
ro.hwui.drop_shadow_cache_size=6
ro.hwui.texture_cache_flushrate=0.4
ro.hwui.text_small_cache_width=1024
ro.hwui.text_small_cache_height=1024
ro.hwui.text_large_cache_width=2048
ro.hwui.text_large_cache_height=1024
debug.hwui.skia_atrace_enabled=false
config.disable_rtt=true

# LMKD
ro.config.low_ram=false
ro.lmk.use_minfree_levels=true
ro.lmk.kill_timeout_ms=100
ro.lmk.swap_util_max=90
ro.lmk.debug=false
ro.lmk.log_stats=false

# Media
media.settings.xml=/vendor/etc/media_profiles_khaje_v0.xml
media.aac_51_output_enabled=true
media.stagefright.enable-aac=true
media.stagefright.enable-fma2dp=true
media.stagefright.enable-http=true
media.stagefright.enable-player=true
media.stagefright.enable-qcp=true
media.stagefright.enable-scan=true
media.stagefright.thumbnail.prefer_hw_codecs=true

# NFC
ro.nfc.port=I2C

# NTP
persist.backup.ntpServer="0.pool.ntp.org"

# Pre-Rendering
ro.vendor.perf.scroll_opt=true

# Radio
DEVICE_PROVISIONED=1
persist.rcs.supported=1
persist.vendor.radio.atfwd.start=true
ril.subscription.types=NV,RUIM
rild.libpath=/vendor/lib64/libril-qc-hal-qmi.so
ro.telephony.default_network=33,33
telephony.lteOnCdmaDevice=1

# SdCardFS
persist.sys.fuse.passthrough.enable=true

# Soc
ro.soc.manufacturer=QTI

# Sensors
persist.vendor.sensors.enable.mag_filter=true

# SSR
persist.vendor.ssr.enable_ramdumps=1
persist.vendor.ssr.restart_level=ALL_ENABLE

# WLAN
ro.hardware.wlan.dbs=0
ro.hardware.wlan.mimo=0
ro.hardware.wlan.vendor=qcom
ro.hardware.wlan.chip=wcn3988

# Dalvik
ro.dalvik.vm.native.bridge=0
dalvik.vm.dex2oat-resolve-startup-strings=true
dalvik.vm.usap_pool_enabled=true
dalvik.vm.madvise.artfile.size=4294967295
dalvik.vm.usap_refill_threshold=1
dalvik.vm.usap_pool_size_max=4
dalvik.vm.usap_pool_size_min=1
dalvik.vm.usap_pool_refill_delay_ms=1000
dalvik.vm.useartservice=true
dalvik.vm.enable_pr_dexopt=true
dalvik.vm.isolatedprocesses=true
dalvik.vm.lockssuppression=true
dalvik.vm.dex2oat-flags=--inline-max-code-units=64
